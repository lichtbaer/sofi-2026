# Kopieren nach .env und Passwort ändern.
POSTGRES_DB=sofi
POSTGRES_USER=sofi
POSTGRES_PASSWORD=bitte-aendern

# Port, unter dem Caddy Frontend und API ausliefert.
WEB_PORT=8080

# ── Produktion: HTTPS via Let's Encrypt ─────────────────────────────────────
# Domain setzen und die Standardports verwenden — Caddy holt und erneuert die
# Zertifikate dann selbst und leitet HTTP auf HTTPS um. Voraussetzung: die
# DNS-Einträge zeigen auf diesen Server, Port 80 und 443 sind von außen
# erreichbar (ACME-Challenge und Umleitung). Mehrere Hostnamen durch
# Leerzeichen getrennt: SOFI_DOMAIN="horizontfrei.de www.horizontfrei.de"
# Ohne SOFI_DOMAIN bleibt es bei HTTP auf WEB_PORT (lokale Entwicklung).
#SOFI_DOMAIN=horizontfrei.de
#WEB_PORT=80
#WEB_TLS_PORT=443
