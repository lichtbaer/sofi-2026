# Protokollformat ohne die personenbeziehbaren Teile (Audit H1).
#
# Ungefiltert stünde in den Logs beides, was die Seite clientseitig gerade
# vermeidet: der Suchbegriff aus /api/v1/geocode?q=… und die Koordinaten aus
# /api/v1/clouds?lat=…&lon=… — nach einem Klick auf „Mein Standort" also die
# Geräteposition. Zusammen mit der IP wäre das ein Bewegungs- und
# Interessensprofil im Klartext.
#
# Abgeschaltet wird das Protokoll deshalb nicht: Pfad, Statuscode, Dauer und
# Größe sind genau die Diagnose, die man bei einer Lastspitze braucht.
# Gefiltert wird nur, was zur Person führt.
#
# Als Snippet, weil es an zwei Stellen gebraucht wird — unten im globalen
# Block für den Fehlerlog und im Site-Block für den Zugriffslog. Zweimal
# ausgeschrieben liefe es auseinander, sobald jemand nur eine Stelle ändert,
# und genau dann leckte die andere wieder.
#
# Snippets müssen vor ihrem Import stehen; Vorwärtsreferenzen kennt der
# Caddyfile-Parser nicht. Deshalb steht dieser Block noch vor den globalen
# Optionen.
(datenschutz_log) {
	output stderr
	format filter {
		wrap console
		fields {
			# Der Pfad bleibt, die Parameter fallen weg.
			request>uri query {
				delete q
				delete lat
				delete lon
			}
			# Netz statt Anschluss. remote_ip ist die Gegenstelle, client_ip
			# die aus vertrauenswürdigen Proxy-Kopfzeilen aufgelöste Adresse;
			# je nach Aufbau trägt mal die eine, mal die andere den Besucher.
			# Ein nicht vorhandenes Feld ist ein No-op, deshalb beide.
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
		}
	}
}

{
	admin off

	# Der Standardlogger. Er trägt unter anderem http.log.error.*, und dort
	# steht bei einem Proxy-Fehler die vollständige Anfrage — mit Koordinaten
	# und ungekürzter IP. Das ist kein Randfall: Genau bei überlasteter API
	# feuert er, also am Ereignisabend. Ohne diesen Block hinge das Leck
	# daneben, während der Zugriffslog sauber aussähe.
	log {
		import datenschutz_log
	}
}

# Die Site-Adresse kommt aus SOFI_DOMAIN (docker-compose reicht sie durch).
# Mit gesetzter Domain — z. B. horizontfrei.de — holt und erneuert Caddy
# selbsttätig Let's-Encrypt-Zertifikate (Ablage im Volume caddydata) und
# leitet HTTP auf HTTPS um. Dafür müssen die Ports 80 und 443 öffentlich
# erreichbar sein: WEB_PORT=80 und WEB_TLS_PORT=443 in der .env. Mehrere
# Hostnamen gehen durch Leerzeichen getrennt ("horizontfrei.de www.horizontfrei.de").
# Ohne Domain (lokale Entwicklung) bleibt es bei HTTP auf Port 80.
{$SOFI_DOMAIN:http://} {
	encode zstd gzip

	# Alles unter /api geht an FastAPI.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Statisches Frontend. Keine externen Hosts — Schriften, Leaflet und
	# Kartenkacheln liegen unter /vendor bzw. /tiles im selben Origin.
	handle {
		root * /srv
		try_files {path} /Sofi.dc.html
		file_server

		# Nur hier, nicht global: sonst überschreibt der Matcher auch die
		# Cache-Vorgaben der API-Antworten (overlay.png).
		@static path *.js *.css *.woff2 *.png *.svg
		header @static Cache-Control "public, max-age=3600"
	}

	header {
		# Genau ein Fremdhost: die Kartenkacheln. Skripte, Schriften, Stile und
		# alle Datenabrufe bleiben beim eigenen Origin — img-src ist die einzige
		# Ausnahme, und Rasterkacheln laufen als <img>, brauchen also kein
		# connect-src.
		# 'unsafe-eval' verlangt die DC-Laufzeit: sie wertet die Logik-Klasse aus
		# dem <script type="text/x-dc">-Block als String aus. Ohne sie rendert
		# nur das Template ohne Logik. Zusammen mit dem ohnehin nötigen
		# 'unsafe-inline' ist script-src damit schwach — der Datenschutzgewinn
		# steckt in connect-src, font-src und img-src, und die bleiben scharf.
		# Ein kompilierter Build aus dem DC-Tooling würde beides überflüssig machen.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'"

		# Nicht "no-referrer": die OSM-Kachelpolicy verlangt einen gültigen
		# Referer. "strict-origin-when-cross-origin" sendet nach außen nur die
		# Herkunft, nicht den Pfad — der gesuchte Ort steht ohnehin nur im
		# Fragment und wird nie mitgeschickt.
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Cross-Origin-Opener-Policy "same-origin"

		# Ein Jahr HSTS, sobald über HTTPS ausgeliefert. Über blankes HTTP
		# ignorieren Browser den Header (RFC 6797) — die lokale Entwicklung
		# stört er also nicht. Kein upgrade-insecure-requests in der CSP:
		# alle Verweise sind relativ, die Kacheln ohnehin https — Mixed
		# Content kann nicht entstehen, und im HTTP-Entwicklungsbetrieb
		# würde die Direktive die eigenen Assets kaputt-upgraden.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Der Zugriffslog. Das Format kommt aus dem Snippet oben — dieselbe
	# Filterung wie beim Standardlogger, damit die beiden nicht auseinanderlaufen.
	# Der Block wird gebraucht, um das Zugriffsprotokoll für diese Site
	# überhaupt einzuschalten: der globale Block allein erzeugt keine Zeile.
	#
	# Nach jeder Änderung prüfen — Caddy startet mit fehlerhafter Konfiguration
	# gar nicht:
	#   docker compose run --rm --no-deps web \
	#     caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
	#
	# Das „caddy" gehört dazu: das offizielle Image setzt kein ENTRYPOINT,
	# sondern nur CMD. Ohne den Programmnamen sucht Docker eine ausführbare
	# Datei namens „validate" und bricht ab, bevor die Konfiguration überhaupt
	# gelesen wird — der Fehler sieht dann nach einem Konfigurationsproblem aus
	# und ist keins.
	#
	# Ohne .env (compose erzwingt POSTGRES_PASSWORD) geht es auch direkt:
	#   docker run --rm -v "$PWD/web/Caddyfile:/etc/caddy/Caddyfile:ro" \
	#     caddy:2-alpine caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
	log {
		import datenschutz_log
	}
}
